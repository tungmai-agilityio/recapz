[Unit]
Description=Recapz server
After=network-online.target recapz-xvfb.service
Wants=network-online.target recapz-xvfb.service

[Service]
User=recapz
Group=recapz
WorkingDirectory=/var/lib/recapz
Environment=RECAPZ_CONFIG=/etc/recapz/config.toml
Environment=RUST_LOG=info
Environment=DISPLAY=:99
Environment=XAUTHORITY=/var/lib/recapz/xauthority
# RECAPZ_SECRET_KEY (64 hex characters) lives here, not in config.toml.
EnvironmentFile=/etc/recapz/recapz.env
ExecStart=/usr/local/bin/recapz
Restart=on-failure
RestartSec=5

# Hardening: the service only writes under /var/lib/recapz.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/recapz
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
# Chromium's sandbox needs user namespaces, so no RestrictNamespaces.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
