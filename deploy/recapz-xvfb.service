[Unit]
Description=Recapz virtual display for the notetaker browser

[Service]
User=recapz
Group=recapz
ExecStart=/usr/bin/Xvfb :99 -screen 0 1280x800x24 -nolisten tcp
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=false
ProtectHome=true
ProtectSystem=strict
# Xvfb creates its socket under /tmp/.X11-unix.
ReadWritePaths=/tmp

[Install]
WantedBy=multi-user.target
