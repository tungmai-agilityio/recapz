# Copy to /etc/recapz/recapz.env (mode 0640, owner recapz:recapz). Never commit the real file.
# Read by recapz.service as environment variables; none of these belong in config.toml.

# 64 hex characters: `openssl rand -hex 32`. Encrypts stored Google refresh tokens.
# Keep a copy in a password manager, apart from backups; losing it means every member reconnects the calendar.
RECAPZ_SECRET_KEY=

# Speech provider key (Deepgram). The server refuses to start without it.
RECAPZ_SPEECH_KEY=

# S3-compatible object storage access key for the private recordings bucket (see [storage] in config.toml).
# Leave empty only if `bucket` is empty (recordings then stay on the local disk).
RECAPZ_STORAGE_KEY_ID=
RECAPZ_STORAGE_SECRET=

# Key for the language model provider (reports, Ask). Overrides `[llm] api_key` in config.toml.
RECAPZ_LLM_KEY=

# SMTP relay login for the "report is ready" email (host, port and sender are [mail] in config.toml).
# Any SMTP provider works. Leave empty if the relay needs no login.
RECAPZ_SMTP_USER=
RECAPZ_SMTP_PASSWORD=
