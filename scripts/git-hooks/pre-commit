#!/bin/sh
# Refuses a commit whose author or committer email is not a work address, or that stages a signing key.
# Enable once per clone with `make hooks`.
for who in GIT_AUTHOR_IDENT GIT_COMMITTER_IDENT; do
  email=$(git var "$who" | sed 's/.*<\(.*\)>.*/\1/')
  case "$email" in
    *@asnet.com.vn | *+tungmai-agilityio@users.noreply.github.com) ;;
    *)
      echo "pre-commit: $who email '$email' is not a work address; set user.email" >&2
      exit 1
      ;;
  esac
done
# Deploy secrets (.secrets/, used by scripts/bootstrap-host.sh) must never be committed, even with git add -f.
if git diff --cached --name-only | grep -q '^\.secrets/'; then
  echo "pre-commit: a file under .secrets/ is staged; unstage it" >&2
  exit 1
fi
# The updater signing key must never be committed (docs/deploy.md, "macOS app").
if git diff --cached --name-only | grep -qE '\.key$' ||
  git diff --cached -U0 | grep -qiE '^\+untrusted comment: .*secret key'; then
  echo "pre-commit: a private signing key is staged; unstage it" >&2
  exit 1
fi
exit 0
