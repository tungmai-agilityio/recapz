[Unit]
Description=Recapz offsite backup (encrypted)
After=recapz-backup.service

[Service]
Type=oneshot
# Own user, not recapz: /etc/recapz/offsite.env (root:root 0600, read by systemd as root) holds the bucket key and
# the restic password, which the app user must not read. Group recapz lets it read /var/backups/recapz (0750).
User=recapz-offsite
SupplementaryGroups=recapz
# RESTIC_REPOSITORY, RESTIC_PASSWORD, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
EnvironmentFile=/etc/recapz/offsite.env
# keep restic's cache out of /var/lib/recapz, or the next local backup copies it
CacheDirectory=recapz-offsite
Environment=RESTIC_CACHE_DIR=/var/cache/recapz-offsite
ExecStart=/usr/local/bin/recapz-offsite /var/backups/recapz
