[Unit]
Description=Recapz server
After=network-online.target
Wants=network-online.target

[Service]
User=recapz
Group=recapz
WorkingDirectory=/var/lib/recapz
Environment=RECAPZ_CONFIG=/etc/recapz/config.toml
Environment=RUST_LOG=info
ExecStart=/usr/local/bin/recapz
Restart=on-failure
RestartSec=5

# Hardening: the service only writes under /var/lib/recapz.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/recapz
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
